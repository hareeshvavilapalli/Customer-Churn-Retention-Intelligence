        "lineageTag": "08b34900-f666-4663-9138-9a14af61c9d3",
        "measures": [
          {
            "name": "Total Customers",
            "displayFolder": "1. Volume & Churn",
            "expression": "COUNTROWS('CustomerChurn')",
            "formatString": "#,##0",
            "lineageTag": "e4dce773-b8d3-4120-b09a-b8f477dfc384"
          },
          {
            "name": "Churned Customers",
            "displayFolder": "1. Volume & Churn",
            "expression": "CALCULATE(COUNTROWS('CustomerChurn'), 'CustomerChurn'[Churn] = \"Yes\")",
            "formatString": "#,##0",
            "lineageTag": "e2efccaa-f1de-4f43-8ba8-b1f7ee8ad171"
          },
          {
            "name": "Retained Customers",
            "displayFolder": "1. Volume & Churn",
            "expression": "CALCULATE(COUNTROWS('CustomerChurn'), 'CustomerChurn'[Churn] = \"No\")",
            "formatString": "#,##0",
            "lineageTag": "b6dedb66-4755-4048-92cb-c99bbe49d10c"
          },
          {
            "name": "Churn Rate %",
            "displayFolder": "1. Volume & Churn",
            "expression": "DIVIDE([Churned Customers], [Total Customers], 0)",
            "formatString": "0.00%",
            "lineageTag": "c9958e2b-1288-41d4-ae45-8ad4b73537da"
          },
          {
            "name": "Retention Rate %",
            "displayFolder": "1. Volume & Churn",
            "expression": "DIVIDE([Retained Customers], [Total Customers], 0)",
            "formatString": "0.00%",
            "lineageTag": "e22c7777-9667-44c5-8b1f-82684abc1543"
          },
          {
            "name": "Total Monthly Revenue (MRR)",
            "displayFolder": "2. Financial & Revenue",
            "expression": "SUM('CustomerChurn'[MonthlyCharges])",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "45980e6c-2989-4169-9298-41e53d90e4bc"
          },
          {
            "name": "Lost MRR",
            "displayFolder": "2. Financial & Revenue",
            "expression": "CALCULATE(SUM('CustomerChurn'[MonthlyCharges]), 'CustomerChurn'[Churn] = \"Yes\")",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "c41548c8-9536-452f-89e2-705763beb4ef"
          },
          {
            "name": "Retained MRR",
            "displayFolder": "2. Financial & Revenue",
            "expression": "CALCULATE(SUM('CustomerChurn'[MonthlyCharges]), 'CustomerChurn'[Churn] = \"No\")",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "5b08a2f0-e128-49f1-b30a-2e9bc14a423c"
          },
          {
            "name": "Lost MRR %",
            "displayFolder": "2. Financial & Revenue",
            "expression": "DIVIDE([Lost MRR], [Total Monthly Revenue (MRR)], 0)",
            "formatString": "0.00%",
            "lineageTag": "45e3c1ac-4fbf-423d-9e73-9a75ba8c296a"
          },
          {
            "name": "Total Cumulative Revenue",
            "displayFolder": "2. Financial & Revenue",
            "expression": "SUM('CustomerChurn'[TotalCharges])",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "6484b222-db95-4a0b-975d-c478a7eaadce"
          },
          {
            "name": "Average Monthly Charges",
            "displayFolder": "2. Financial & Revenue",
            "expression": "AVERAGE('CustomerChurn'[MonthlyCharges])",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "a508f793-b0fe-4328-88fb-0fb824231f0d"
          },
          {
            "name": "Average Monthly Charges - Churned",
            "displayFolder": "2. Financial & Revenue",
            "expression": "CALCULATE(AVERAGE('CustomerChurn'[MonthlyCharges]), 'CustomerChurn'[Churn] = \"Yes\")",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "60ab0002-7524-4c8f-9836-a8d81117cf39"
          },
          {
            "name": "Average Monthly Charges - Retained",
            "displayFolder": "2. Financial & Revenue",
            "expression": "CALCULATE(AVERAGE('CustomerChurn'[MonthlyCharges]), 'CustomerChurn'[Churn] = \"No\")",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "6403ae0d-6479-469d-b7e9-7d51e1cb2ad6"
          },
          {
            "name": "Monthly Charge Delta",
            "displayFolder": "2. Financial & Revenue",
            "expression": "[Average Monthly Charges - Churned] - [Average Monthly Charges - Retained]",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "be602185-9625-4718-9ea2-a5dc9f8a08b1"
          },
          {
            "name": "Average Tenure",
            "displayFolder": "2. Financial & Revenue",
            "expression": "AVERAGE('CustomerChurn'[tenure])",
            "formatString": "0.0",
            "lineageTag": "b593d4f8-9636-4a3e-9172-0acb19acb515"
          },
          {
            "name": "Average Tenure - Churned",
            "displayFolder": "2. Financial & Revenue",
            "expression": "CALCULATE(AVERAGE('CustomerChurn'[tenure]), 'CustomerChurn'[Churn] = \"Yes\")",
            "formatString": "0.0",
            "lineageTag": "2eb59573-5c21-4bea-ace3-6c34d33c8f5a"
          },
          {
            "name": "Average Tenure - Retained",
            "displayFolder": "2. Financial & Revenue",
            "expression": "CALCULATE(AVERAGE('CustomerChurn'[tenure]), 'CustomerChurn'[Churn] = \"No\")",
            "formatString": "0.0",
            "lineageTag": "52a2233d-04ec-499b-8056-668b80bf24cb"
          },
          {
            "name": "Average Total Charges",
            "displayFolder": "2. Financial & Revenue",
            "expression": "AVERAGE('CustomerChurn'[TotalCharges])",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "2630e957-fb06-4d6a-b002-5fefe4314fe5"
          },
          {
            "name": "Customer Lifetime Value (LTV)",
            "displayFolder": "2. Financial & Revenue",
            "expression": "[Average Total Charges]",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "6c0c5a8d-ef39-473f-a411-fb1dfa0bc299"
          },
          {
            "name": "Revenue at Risk (Critical MRR At Stake)",
            "displayFolder": "3. Risk Intelligence",
            "expression": "CALCULATE(SUM('CustomerChurn'[MonthlyCharges]), 'CustomerChurn'[Risk_Tier] = \"1. Critical Risk (Score 7-9)\")",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "9887bab5-3c5d-48c9-b7d6-390b4a0d9e38"
          },
          {
            "name": "Realized Lost MRR (Critical)",
            "displayFolder": "3. Risk Intelligence",
            "expression": "CALCULATE(SUM('CustomerChurn'[MonthlyCharges]), 'CustomerChurn'[Risk_Tier] = \"1. Critical Risk (Score 7-9)\", 'CustomerChurn'[Churn] = \"Yes\")",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "3f91b52e-8d74-4d28-ba55-163c6ea3b10f"
          },
          {
            "name": "Critical Risk Customer Count",
            "displayFolder": "3. Risk Intelligence",
            "expression": "CALCULATE(COUNTROWS('CustomerChurn'), 'CustomerChurn'[Risk_Tier] = \"1. Critical Risk (Score 7-9)\")",
            "formatString": "#,##0",
            "lineageTag": "cb6b4cee-715c-496b-9c9e-f41c2dda89b6"
          },
          {
            "name": "Moderate Risk Customer Count",
            "displayFolder": "3. Risk Intelligence",
            "expression": "CALCULATE(COUNTROWS('CustomerChurn'), 'CustomerChurn'[Risk_Tier] = \"2. Moderate Risk (Score 4-6)\")",
            "formatString": "#,##0",
            "lineageTag": "e44f3742-7bd1-42b9-b707-4cca74cc46a5"
          },
          {
            "name": "Low Risk Customer Count",
            "displayFolder": "3. Risk Intelligence",
            "expression": "CALCULATE(COUNTROWS('CustomerChurn'), 'CustomerChurn'[Risk_Tier] = \"3. Low Risk (Score 0-3)\")",
            "formatString": "#,##0",
            "lineageTag": "8a2142e4-ae0c-4aab-9022-e5f979503f11"
          },
          {
            "name": "Critical Risk Churn Rate %",
            "displayFolder": "3. Risk Intelligence",
            "expression": "DIVIDE(CALCULATE(COUNTROWS('CustomerChurn'), 'CustomerChurn'[Risk_Tier] = \"1. Critical Risk (Score 7-9)\", 'CustomerChurn'[Churn] = \"Yes\"), [Critical Risk Customer Count], 0)",
            "formatString": "0.00%",
            "lineageTag": "7b1dd08c-435c-4a56-92f1-70dd4c06a869"
          },
          {
            "name": "Critical Risk Share of Total Churn %",
            "displayFolder": "3. Risk Intelligence",
            "expression": "DIVIDE(CALCULATE(COUNTROWS('CustomerChurn'), 'CustomerChurn'[Risk_Tier] = \"1. Critical Risk (Score 7-9)\", 'CustomerChurn'[Churn] = \"Yes\"), [Churned Customers], 0)",
            "formatString": "0.00%",
            "lineageTag": "b36a3bbc-9265-4186-a331-0afa3fe73361"
          },
          {
            "name": "High ARPU Lost MRR",
            "displayFolder": "4. Segment Losses",
            "expression": "CALCULATE(SUM('CustomerChurn'[MonthlyCharges]), 'CustomerChurn'[MonthlyCharges] >= 89.85, 'CustomerChurn'[Churn] = \"Yes\")",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "f69f1fc1-694f-49a2-8b23-da0f0a9b0de0"
          },
          {
            "name": "Fiber Optic Lost MRR",
            "displayFolder": "4. Segment Losses",
            "expression": "CALCULATE(SUM('CustomerChurn'[MonthlyCharges]), 'CustomerChurn'[InternetService] = \"Fiber optic\", 'CustomerChurn'[Churn] = \"Yes\")",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "c2da1515-5800-4336-a5f2-90c770fefe62"
          },
          {
            "name": "Month to Month Lost MRR",
            "displayFolder": "4. Segment Losses",
            "expression": "CALCULATE(SUM('CustomerChurn'[MonthlyCharges]), 'CustomerChurn'[Contract] = \"Month-to-month\", 'CustomerChurn'[Churn] = \"Yes\")",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "fa1bac33-ee8c-4938-8f8e-151436841a41"
          }
        ],
        "partitions": [
          {
            "name": "CustomerChurn",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(\"C:\\Users\\V.Leela prasad\\OneDrive\\Desktop\\Customer-Churn-Retention-Intelligence\\dataset\\cleaned_telco_customer_churn.csv\"), [Delimiter=\",\", Columns=25, Encoding=65001, QuoteStyle=QuoteStyle.None]),",
                "    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    TypedTable = Table.TransformColumnTypes(PromotedHeaders, {",
                "        {\"customerID\", type text},",
                "        {\"gender\", type text},",
                "        {\"SeniorCitizen\", Int64.Type},",
                "        {\"Partner\", type text},",
                "        {\"Dependents\", type text},",
                "        {\"tenure\", Int64.Type},",
                "        {\"PhoneService\", type text},",
                "        {\"MultipleLines\", type text},",
                "        {\"InternetService\", type text},",
                "        {\"OnlineSecurity\", type text},",
                "        {\"OnlineBackup\", type text},",
                "        {\"DeviceProtection\", type text},",
                "        {\"TechSupport\", type text},",
                "        {\"StreamingTV\", type text},",
                "        {\"StreamingMovies\", type text},",
                "        {\"Contract\", type text},",
                "        {\"PaperlessBilling\", type text},",
                "        {\"PaymentMethod\", type text},",
                "        {\"MonthlyCharges\", Currency.Type},",
                "        {\"TotalCharges\", Currency.Type},",
                "        {\"Churn\", type text},",
                "        {\"SeniorCitizen_Label\", type text},",
                "        {\"tenure_group\", type text},",
                "        {\"payment_category\", type text},",
                "        {\"service_count\", Int64.Type}",
                "    }),",
                "    AddedTenureSort = Table.AddColumn(TypedTable, \"Tenure_Group_Sort\", each ",
                "        if [tenure_group] = \"0-12m\" then 1",
                "        else if [tenure_group] = \"13-24m\" then 2",
                "        else if [tenure_group] = \"25-36m\" then 3",
                "        else if [tenure_group] = \"37-48m\" then 4",
                "        else if [tenure_group] = \"49-60m\" then 5",
                "        else 6,",
                "        Int64.Type",
                "    ),",
                "    AddedRiskScore = Table.AddColumn(AddedTenureSort, \"Risk_Score\", each ",
                "        (if [Contract] = \"Month-to-month\" then 3 else 0) +",
                "        (if [InternetService] = \"Fiber optic\" then 2 else 0) +",
                "        (if [PaymentMethod] = \"Electronic check\" then 2 else 0) +",
                "        (if [tenure] <= 12 then 2 else 0),",
                "        Int64.Type",
                "    ),",
                "    AddedRiskTier = Table.AddColumn(AddedRiskScore, \"Risk_Tier\", each ",
                "        if [Risk_Score] >= 7 then \"1. Critical Risk (Score 7-9)\"",
                "        else if [Risk_Score] >= 4 then \"2. Moderate Risk (Score 4-6)\"",
                "        else \"3. Low Risk (Score 0-3)\",",
                "        type text",
                "    ),",
                "    AddedRiskTierSort = Table.AddColumn(AddedRiskTier, \"Risk_Tier_Sort\", each ",
                "        if [Risk_Score] >= 7 then 1",
                "        else if [Risk_Score] >= 4 then 2",
                "        else 3,",
                "        Int64.Type",
                "    )",
                "in",
                "    AddedRiskTierSort"
              ],
              "type": "m"
            }
          }
        ]
      }
    ]
  }
}